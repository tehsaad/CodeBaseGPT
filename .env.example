# ─────────────────────────────────────────────────────────────────────────────
# CodeBaseGPT configuration. Copy to .env.local for local development.
# Never commit real values. Every variable is optional for local development
# unless marked [prod-required].
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Hosted PostgreSQL 15+ with the `vector` and `pg_trgm` extensions (e.g. Neon).
# Unset locally: an embedded PGlite database is created in .data/pglite.
# [prod-required] Production refuses to start without it (data would be lost).
DATABASE_URL=
# Local only: run the embedded DB under `next start` (NODE_ENV=production). Never on Vercel.
CBG_ALLOW_EMBEDDED_DB=
# Local only: where the embedded DB lives (default .data/pglite).
CBG_DATA_DIR=
# Max pooled connections per function instance (default 5). Use 1 with very small DB plans.
DATABASE_POOL_MAX=

# ── Authentication (Better Auth) ─────────────────────────────────────────────
# [prod-required] 32+ random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# [prod-required] Public base URL, e.g. https://codebasegpt.vercel.app (http://localhost:3000 locally)
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth app (https://github.com/settings/developers)
#   Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth client (https://console.cloud.google.com/apis/credentials)
#   Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password reset + email verification via Resend (https://resend.com). Optional.
RESEND_API_KEY=
EMAIL_FROM=

# ── Gemma (answers) ──────────────────────────────────────────────────────────
# "google" = Gemini API / Google AI Studio (https://aistudio.google.com/apikey)
# "openai-compatible" = any OpenAI-style endpoint serving Gemma (vLLM, TGI, remote Ollama, ...)
GEMMA_PROVIDER=google
# e.g. gemma-4-26b-a4b-it (google) or the model name your endpoint exposes
GEMMA_MODEL=
GEMMA_API_KEY=
# Required for openai-compatible, e.g. https://my-vllm.example.com/v1
GEMMA_BASE_URL=
# Context window to budget prompts against (default 32000)
GEMMA_CONTEXT_TOKENS=
# Max output tokens incl. hidden reasoning (default 6144 for gemma-4*, else 1600)
GEMMA_MAX_OUTPUT_TOKENS=

# ── Embeddings (optional semantic retrieval, pgvector) ───────────────────────
# "google" or "none". Lexical + graph retrieval is used when unset.
EMBEDDING_PROVIDER=
# default gemini-embedding-001 (stored at 768 dimensions)
EMBEDDING_MODEL=
# Defaults to GEMMA_API_KEY when unset
EMBEDDING_API_KEY=

# ── Web search (Student Stuck Mode) ──────────────────────────────────────────
# "tavily" (https://tavily.com) or "exa" (https://exa.ai)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
EXA_API_KEY=

# ── GitHub API (optional) ────────────────────────────────────────────────────
# Raises the unauthenticated rate limit for PUBLIC imports. Use a fine-grained token
# with public-repository read only. It is never used for private repositories.
GITHUB_TOKEN=
